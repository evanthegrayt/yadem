#!/usr/bin/env bash

set -eo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
readonly SCRIPT_DIR
readonly TARGET_DIR="$SCRIPT_DIR/yadem.d"
readonly LIB_PATH="$SCRIPT_DIR/lib/yadem.sh"

# shellcheck source=bin/lib/yadem.sh
. "$LIB_PATH"

usage() {
    cat <<USAGE
USAGE: ${0##*/} [OPTIONS] TARGET [TARGET...]
       ${0##*/} TARGET --help

Options:
  -t, --test    Show what would happen without installing
  -a, --all     Run the configured target sequence
  -l, --list    List available install targets
  -h, --help    Display this help and exit

Targets:
$(list_targets | sed 's/^/  /')
USAGE
}

run_target() {
    local target="$1"
    local command="$2"
    local target_path="$TARGET_DIR/$target"
    shift 2

    if [[ "$target" == */* || "$target" == .* || ! -f "$target_path" ]]; then
        echo "Unknown install target: $target" >&2
        echo "Run ${0##*/} --list to see available targets." >&2
        return 1
    fi

    (
        set -eo pipefail

        # shellcheck disable=SC2034
        INSTALL_TARGET="$target"
        # shellcheck disable=SC2034
        DRY_RUN="$dry_run"

        # shellcheck source=bin/lib/yadem.sh
        . "$LIB_PATH"
        # shellcheck disable=SC1090
        . "$target_path"

        if ! declare -F "$command" >/dev/null 2>&1; then
            echo "Target '$target' does not implement $command()" >&2
            exit 1
        fi

        "$command" "$@"
    )
}

target_accepts_args() {
    case "$1" in
        dotfiles-uninstall)
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

dry_run=false
list=false
target_help=false
all=false
targets=()
target_args=()

while (($#)); do
    case "$1" in
        -t|--test)
            dry_run=true
            ;;
        -a|--all)
            all=true
            ;;
        -l|--list)
            list=true
            ;;
        -h|--help)
            if ((${#targets[@]})); then
                target_help=true
            else
                usage
                exit
            fi
            ;;
        --)
            shift
            if ((${#targets[@]} == 1)) && target_accepts_args "${targets[0]}"; then
                while (($#)); do
                    target_args+=("$1")
                    shift
                done
                break
            fi

            while (($#)); do
                targets+=("$1")
                shift
            done
            break
            ;;
        -*)
            if ((${#targets[@]} == 1)) && target_accepts_args "${targets[0]}"; then
                target_args+=("$1")
                shift
                continue
            fi

            echo "Invalid option: $1" >&2
            usage >&2
            exit 1
            ;;
        *)
            if ((${#target_args[@]})); then
                target_args+=("$1")
            elif ((${#targets[@]} == 1)) && target_accepts_args "${targets[0]}"; then
                target_args+=("$1")
            else
                targets+=("$1")
            fi
            ;;
    esac
    shift
done

if [[ "$list" == true ]]; then
    list_targets
    exit
fi

if [[ "$all" == true ]]; then
    targets=(all)
fi

if [[ "$target_help" == true ]]; then
    if ((${#targets[@]} != 1)); then
        echo "Target help can only be shown for one target at a time." >&2
        exit 1
    fi

    run_target "${targets[0]}" print_help
    exit
fi

if ((${#target_args[@]} && ${#targets[@]} != 1)); then
    echo "Target arguments can only be passed to one target at a time." >&2
    exit 1
fi

if ((${#targets[@]} == 0)); then
    echo "Must pass at least one install target." >&2
    usage >&2
    exit 1
fi

command=install
if [[ "$dry_run" == true ]]; then
    command=dry_run
fi

for target in "${targets[@]}"; do
    run_target "$target" "$command" "${target_args[@]}"
done
