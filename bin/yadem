#!/usr/bin/env bash

set -eo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
readonly SCRIPT_DIR
readonly TARGET_DIR="$SCRIPT_DIR/yadem.d"
readonly LIB_PATH="$SCRIPT_DIR/lib/yadem.sh"

# shellcheck source=bin/lib/yadem.sh
. "$LIB_PATH"

usage() {
    cat <<USAGE
USAGE: ${0##*/} [OPTIONS] TARGET [ARGS...]
       ${0##*/} [OPTIONS] --edit TARGET
       ${0##*/} TARGET --help

Options:
  -t, --test    Show what would happen without installing
  -a, --all     Run the configured target sequence
  -l, --list    List available install targets
  -e, --edit    Open a target in YADEM_EDITOR, VISUAL, EDITOR, or vi
  -h, --help    Display this help and exit

Run one target per invocation. Use --all for configured target sequences.

Targets:
$(list_target_usages | sed 's/^/  /')
USAGE
}

target_path_for() {
    local target="$1"

    printf "%s\n" "$TARGET_DIR/$target.bash"
}

target_exists() {
    local target="$1"
    local target_path

    target_path="$(target_path_for "$target")"
    [[ "$target" != */* && "$target" != .* && -f "$target_path" ]]
}

report_unknown_target() {
    local target="$1"

    echo "Unknown install target: $target" >&2
    echo "Run ${0##*/} --list to see available targets." >&2
}

target_argument_usage() {
    local target="$1"
    local target_path

    target_exists "$target" || return 1
    target_path="$(target_path_for "$target")"

    (
        # shellcheck source=bin/lib/yadem.sh
        . "$LIB_PATH"
        # shellcheck disable=SC1090
        . "$target_path"

        declare -F accepted_arguments >/dev/null 2>&1 || exit 1
        accepted_arguments
    )
}

list_target_usages() {
    local target
    local usage

    while IFS= read -r target; do
        if usage="$(target_argument_usage "$target")"; then
            printf "%s %s\n" "$target" "$usage"
        else
            printf "%s\n" "$target"
        fi
    done < <(list_targets)
}

run_target() {
    local target="$1"
    local command="$2"
    local target_path
    shift 2

    if ! target_exists "$target"; then
        report_unknown_target "$target"
        return 1
    fi

    target_path="$(target_path_for "$target")"

    (
        set -eo pipefail

        # shellcheck disable=SC2034
        INSTALL_TARGET="$target"
        # shellcheck disable=SC2034
        DRY_RUN="$dry_run"

        # shellcheck source=bin/lib/yadem.sh
        . "$LIB_PATH"
        # shellcheck disable=SC1090
        . "$target_path"

        if ! declare -F "$command" >/dev/null 2>&1; then
            echo "Target '$target' does not implement $command()" >&2
            exit 1
        fi

        "$command" "$@"
    )
}

edit_target() {
    local target="$1"
    local target_path
    local editor
    local -a editor_command

    if ! target_exists "$target"; then
        report_unknown_target "$target"
        return 1
    fi

    load_yadem_config
    target_path="$(target_path_for "$target")"
    # YADEM_EDITOR is loaded in this shell by load_yadem_config.
    # shellcheck disable=SC2031
    editor="${YADEM_EDITOR:-${VISUAL:-${EDITOR:-vi}}}"
    read -r -a editor_command <<< "$editor"

    if ((${#editor_command[@]} == 0)); then
        editor_command=(vi)
    fi

    exec "${editor_command[@]}" "$target_path"
}

dry_run=false
list=false
target_help=false
all=false
edit=false
target=""
target_args=()

while (($#)); do
    if [[ -n "$target" ]]; then
        case "$1" in
            -h|--help)
                if ((${#target_args[@]} == 0)); then
                    target_help=true
                else
                    target_args+=("$1")
                fi
                ;;
            --)
                shift
                while (($#)); do
                    target_args+=("$1")
                    shift
                done
                break
                ;;
            *)
                target_args+=("$1")
                ;;
        esac
        shift
        continue
    fi

    case "$1" in
        -t|--test)
            dry_run=true
            ;;
        -a|--all)
            all=true
            ;;
        -l|--list)
            list=true
            ;;
        -e|--edit)
            edit=true
            ;;
        -h|--help)
            usage
            exit
            ;;
        --)
            shift
            if (($#)); then
                target="$1"
                shift
                while (($#)); do
                    target_args+=("$1")
                    shift
                done
            fi
            break
            ;;
        -*)
            echo "Invalid option: $1" >&2
            usage >&2
            exit 1
            ;;
        *)
            target="$1"
            ;;
    esac
    shift
done

if [[ "$edit" == true ]]; then
    if [[ "$all" == true ]]; then
        echo "--edit cannot be combined with --all." >&2
        exit 1
    fi

    if [[ "$list" == true ]]; then
        echo "--edit cannot be combined with --list." >&2
        exit 1
    fi

    if [[ "$dry_run" == true ]]; then
        echo "--edit cannot be combined with --test." >&2
        exit 1
    fi

    if [[ "$target_help" == true ]]; then
        echo "--edit cannot be combined with target help." >&2
        exit 1
    fi

    if [[ -z "$target" ]]; then
        echo "Must pass an install target to --edit." >&2
        usage >&2
        exit 1
    fi

    if ((${#target_args[@]})); then
        echo "--edit cannot be combined with target arguments." >&2
        exit 1
    fi

    edit_target "$target"
    exit
fi

if [[ "$list" == true ]]; then
    list_targets
    exit
fi

if [[ "$all" == true ]]; then
    if [[ -n "$target" || ${#target_args[@]} -ne 0 ]]; then
        echo "--all cannot be combined with a target." >&2
        exit 1
    fi

    target=all
fi

if [[ "$target_help" == true ]]; then
    if ((${#target_args[@]})); then
        echo "Target help cannot be combined with arguments." >&2
        exit 1
    fi

    run_target "$target" print_help
    exit
fi

if [[ -z "$target" ]]; then
    echo "Must pass an install target." >&2
    usage >&2
    exit 1
fi

if ! target_exists "$target"; then
    report_unknown_target "$target"
    exit 1
fi

if ((${#target_args[@]})) && ! target_argument_usage "$target" >/dev/null; then
    echo "Target '$target' does not accept arguments: ${target_args[*]}" >&2
    exit 1
fi

command=install
if [[ "$dry_run" == true ]]; then
    command=dry_run
fi

run_target "$target" "$command" "${target_args[@]}"
