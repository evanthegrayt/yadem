#!/usr/bin/env bash

set -eo pipefail

# @description Resolves a script path by following symlinks without readlink -f.
# @internal
# @arg $1 string Script path.
# @stdout Physical script path.
# @exitcode 0 Path was resolved.
# @exitcode 1 Path could not be resolved.
resolve_script_path() {
    local source="$1"
    local source_dir
    local linked_source

    while [[ -L "$source" ]]; do
        source_dir="$(cd -- "$(dirname -- "$source")" >/dev/null 2>&1 && pwd -P)" || return 1
        linked_source="$(readlink "$source")" || return 1

        if [[ "$linked_source" == /* ]]; then
            source="$linked_source"
        else
            source="$source_dir/$linked_source"
        fi
    done

    source_dir="$(cd -- "$(dirname -- "$source")" >/dev/null 2>&1 && pwd -P)" || return 1
    printf "%s/%s\n" "$source_dir" "$(basename -- "$source")"
}

# Resolve the executable directory even when invoked through a PATH symlink.
SCRIPT_PATH="$(resolve_script_path "${BASH_SOURCE[0]}")"
readonly SCRIPT_PATH
SCRIPT_DIR="$(cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd -P)"
readonly SCRIPT_DIR
REPO_DIR="$(cd -- "$SCRIPT_DIR/.." && pwd -P)"
readonly REPO_DIR
# shellcheck disable=SC2034 # Kept as the resolved built-in target directory.
readonly TARGET_DIR="$REPO_DIR/targets"
readonly LIB_PATH="$REPO_DIR/lib/yadem.sh"

# shellcheck source=lib/yadem.sh
. "$LIB_PATH"

# @description Prints global command usage.
# @internal
# @noargs
# @stdout Global yadem usage, options, and target summary.
# @exitcode 0 Usage was printed.
usage() {
    cat <<USAGE
USAGE: ${0##*/} [OPTIONS] TARGET [ARGS...]
       ${0##*/} [OPTIONS] --edit TARGET
       ${0##*/} TARGET --help

Options:
  -t, --test    Show what would happen without installing
  -a, --all     Run the configured target sequence
  -l, --list    List available install targets
      --verbose Show resolved target paths with --list
  -e, --edit    Open a target in YADEM_EDITOR, VISUAL, EDITOR, or vi
  -h, --help    Display this help and exit

Run one target per invocation. Use --all for configured target sequences.

Targets:
$(list_target_usages | sed 's/^/  /')
USAGE
}

# @description Prints the standard unknown-target error.
# @internal
# @arg $1 string Unknown target name.
# @stderr Error and recovery hint.
# @exitcode 0 The message was printed.
report_unknown_target() {
    local target="$1"

    echo "Unknown install target: $target" >&2
    echo "Run ${0##*/} --list to see available targets." >&2
}

# @description Reads a target's accepted trailing argument metadata.
# @internal
# @arg $1 string Target name without `.bash`.
# @stdout Usage metadata printed by the target's `accepted_arguments`.
# @exitcode 0 The target declares accepted arguments.
# @exitcode 1 The target does not exist or does not declare accepted arguments.
target_argument_usage() {
    local target="$1"
    local target_path

    yadem_target_exists "$target" || return 1
    target_path="$(yadem_target_path_for "$target")"

    # Source target metadata in a subshell so helper functions or variables from
    # one target cannot leak into global help generation for the next target.
    (
        # shellcheck source=lib/yadem.sh
        . "$LIB_PATH"
        # shellcheck disable=SC1090
        . "$target_path"

        # declare -F checks for a function definition without invoking it.
        declare -F accepted_arguments >/dev/null 2>&1 || exit 1
        accepted_arguments
    )
}

# @description Lists target names with target-specific argument usage when available.
# @internal
# @noargs
# @stdout One target summary per line.
# @exitcode 0 Always.
list_target_usages() {
    local target
    local usage

    while IFS= read -r target; do
        if usage="$(target_argument_usage "$target")"; then
            printf "%s %s\n" "$target" "$usage"
        else
            printf "%s\n" "$target"
        fi
    # Process substitution feeds yadem_list_targets into the loop without a pipeline
    # subshell, so variables assigned in the loop would remain available here.
    done < <(yadem_list_targets)
}

# @description Loads a target and invokes one command function inside an isolated subshell.
# @internal
# @arg $1 string Target name without `.bash`.
# @arg $2 string Target command function, usually `install`, `dry_run`, or `print_help`.
# @arg $@ string Arguments passed through to the target command.
# @exitcode 0 The target command succeeded.
# @exitcode 1 The target is unknown or does not implement the command.
run_target() {
    local target="$1"
    local command="$2"
    local target_path
    shift 2

    if ! yadem_target_exists "$target"; then
        report_unknown_target "$target"
        return 1
    fi

    target_path="$(yadem_target_path_for "$target")"

    # Run every target in a subshell so sourced target functions, target-local
    # globals, and DRY_RUN/INSTALL_TARGET changes do not leak into the dispatcher.
    (
        set -eo pipefail

        # shellcheck disable=SC2034
        INSTALL_TARGET="$target"
        # shellcheck disable=SC2034
        DRY_RUN="$dry_run"

        # shellcheck source=lib/yadem.sh
        . "$LIB_PATH"
        # shellcheck disable=SC1090
        . "$target_path"

        if ! declare -F "$command" >/dev/null 2>&1; then
            echo "Target '$target' does not implement $command()" >&2
            exit 1
        fi

        "$command" "$@"
    )
}

# @description Opens a target file in the configured editor.
# @internal
# @arg $1 string Target name without `.bash`.
# @exitcode 0 The editor process replaces yadem.
# @exitcode 1 The target is unknown or editor resolution fails.
edit_target() {
    local target="$1"
    local target_path
    local editor
    local -a editor_command

    if ! yadem_target_exists "$target"; then
        report_unknown_target "$target"
        return 1
    fi

    yadem_load_config
    target_path="$(yadem_target_path_for "$target")"
    # YADEM_EDITOR is loaded in this shell by yadem_load_config.
    # shellcheck disable=SC2031
    editor="${YADEM_EDITOR:-${VISUAL:-${EDITOR:-vi}}}"
    # This intentionally supports simple editor commands like "vim -p"; it is
    # not a full shell parser for quoted editor arguments.
    read -r -a editor_command <<< "$editor"

    if ((${#editor_command[@]} == 0)); then
        editor_command=(vi)
    fi

    exec "${editor_command[@]}" "$target_path"
}

dry_run=false
list=false
target_help=false
all=false
edit=false
verbose=false
target=""
target_args=()

while (($#)); do
    if [[ -n "$target" ]]; then
        case "$1" in
            -h|--help)
                if ((${#target_args[@]} == 0)); then
                    target_help=true
                else
                    target_args+=("$1")
                fi
                ;;
            --)
                shift
                while (($#)); do
                    target_args+=("$1")
                    shift
                done
                break
                ;;
            *)
                target_args+=("$1")
                ;;
        esac
        shift
        continue
    fi

    case "$1" in
        -t|--test)
            dry_run=true
            ;;
        -a|--all)
            all=true
            ;;
        -l|--list)
            list=true
            ;;
        --verbose)
            verbose=true
            ;;
        -e|--edit)
            edit=true
            ;;
        -h|--help)
            usage
            exit
            ;;
        --)
            shift
            if (($#)); then
                target="$1"
                shift
                while (($#)); do
                    target_args+=("$1")
                    shift
                done
            fi
            break
            ;;
        -*)
            echo "Invalid option: $1" >&2
            usage >&2
            exit 1
            ;;
        *)
            target="$1"
            ;;
    esac
    shift
done

if [[ "$edit" == true ]]; then
    if [[ "$all" == true ]]; then
        echo "--edit cannot be combined with --all." >&2
        exit 1
    fi

    if [[ "$list" == true ]]; then
        echo "--edit cannot be combined with --list." >&2
        exit 1
    fi

    if [[ "$dry_run" == true ]]; then
        echo "--edit cannot be combined with --test." >&2
        exit 1
    fi

    if [[ "$verbose" == true ]]; then
        echo "--edit cannot be combined with --verbose." >&2
        exit 1
    fi

    if [[ "$target_help" == true ]]; then
        echo "--edit cannot be combined with target help." >&2
        exit 1
    fi

    if [[ -z "$target" ]]; then
        echo "Must pass an install target to --edit." >&2
        usage >&2
        exit 1
    fi

    if ((${#target_args[@]})); then
        echo "--edit cannot be combined with target arguments." >&2
        exit 1
    fi

    edit_target "$target"
    exit
fi

if [[ "$list" == true ]]; then
    if [[ "$verbose" == true ]]; then
        yadem_list_targets_verbose
        exit
    fi

    yadem_list_targets
    exit
fi

if [[ "$verbose" == true ]]; then
    echo "--verbose requires --list." >&2
    exit 1
fi

if [[ "$all" == true ]]; then
    if [[ -n "$target" || ${#target_args[@]} -ne 0 ]]; then
        echo "--all cannot be combined with a target." >&2
        exit 1
    fi

    target=all
fi

if [[ "$target_help" == true ]]; then
    if ((${#target_args[@]})); then
        echo "Target help cannot be combined with arguments." >&2
        exit 1
    fi

    run_target "$target" print_help
    exit
fi

if [[ -z "$target" ]]; then
    echo "Must pass an install target." >&2
    usage >&2
    exit 1
fi

if ! yadem_target_exists "$target"; then
    report_unknown_target "$target"
    exit 1
fi

if ((${#target_args[@]})) && ! target_argument_usage "$target" >/dev/null; then
    echo "Target '$target' does not accept arguments: ${target_args[*]}" >&2
    exit 1
fi

command=install
if [[ "$dry_run" == true ]]; then
    command=dry_run
fi

run_target "$target" "$command" "${target_args[@]}"
